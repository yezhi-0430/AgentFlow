# Langfuse 配置示例

# 复制此文件为 .env 并填入你的 Langfuse 凭据

# Langfuse API 密钥（从 https://cloud.langfuse.com 获取）
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# Langfuse 服务器地址
# 云端版本使用：https://cloud.langfuse.com
# 自托管版本使用你的服务器地址
LANGFUSE_HOST=https://cloud.langfuse.com

# 是否启用追踪（true/false）
# 默认为 false，需要手动开启
ENABLE_LANGFUSE_TRACING=false

# 是否把任务/输入/输出等用户内容上传到 Langfuse（true/false）
# 默认 false：只上传 id、状态、耗时、模型名、token 用量等元数据；
# 开启前会做密钥/连接配置脱敏，但仍会外发业务文本，请自行确认合规。
LANGFUSE_CAPTURE_CONTENT=false

# 是否在每次工作流执行后自动评估并写入 Langfuse 评分（true/false）
AUTO_EVALUATE=false

# 评审模型（LLM-as-a-Judge）：支持 OpenRouter / OpenAI 兼容接口
OPENAI_API_KEY=sk-or-v1-...
OPENAI_BASE_URL=https://openrouter.ai/api/v1
EVAL_MODEL=openai/gpt-4o-mini
# 写入 Langfuse 的评分名称（默认 auto-quality）
EVAL_SCORE_NAME=auto-quality

# 执行控制（默认保持旧行为：不超时、不重试）
# 单步超时秒数；0 表示不启用
AGENTFLOW_STEP_TIMEOUT_SECONDS=0
# 单步最大尝试次数（1-5，默认 1 不重试；仅对超时/限流/网络/服务端错误重试）
AGENTFLOW_MAX_ATTEMPTS=1

# 本地记录保留策略
# 单步输入/输出落库截断长度（0 不截断）
AGENTFLOW_RECORD_TEXT_LIMIT=20000
# 最多保留多少条运行记录（0 不限制）
AGENTFLOW_MAX_RUNS=1000
# 运行记录保留天数（0 不按时间清理）
AGENTFLOW_RUN_RETENTION_DAYS=0

# 可选：本地 API Token。设置后所有 /api/* 需要 Authorization: Bearer <token>
# 前端需要在 frontend/.env 设置 VITE_API_TOKEN；仅用于本地/可信网络，不要公开部署。
# AGENTFLOW_API_TOKEN=change-me

# Harness²-lite：执行证据（默认关闭，开启后只写本地文件，写入前脱敏）
AGENTFLOW_EVIDENCE_ENABLED=false
# 证据目录（默认 backend/evidence）
# AGENTFLOW_EVIDENCE_DIR=
AGENTFLOW_EVIDENCE_RETENTION_DAYS=90
AGENTFLOW_EVIDENCE_MAX_BYTES=200000

# Harness²-lite：独立 LLM judge（默认关闭；单轮预算 50 次调用）
# 需要 AGENTFLOW_EXPERIMENT_LLM_JUDGE=1 才会真正调用
AGENTFLOW_EXPERIMENT_LLM_JUDGE=0
AGENTFLOW_JUDGE_MAX_CALLS=50
# 默认复用 OPENAI_API_KEY/OPENAI_BASE_URL/EVAL_MODEL；也可单独指定：
# AGENTFLOW_JUDGE_API_KEY=sk-...
# AGENTFLOW_JUDGE_BASE_URL=https://openrouter.ai/api/v1
# AGENTFLOW_JUDGE_MODEL=openai/gpt-4o-mini

